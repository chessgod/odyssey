TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs - one per person who should get alerts and be
# able to send commands (/status, /peek, /stop, etc). Each person must have
# messaged the bot at least once first (Telegram requires this before a bot
# can message them). Find a chat ID by messaging @userinfobot on Telegram.
# Single ID also works fine: TELEGRAM_CHAT_IDS=123456
TELEGRAM_CHAT_IDS=

# Optional: route Playwright fetches through a proxy (e.g. if the VM's own
# IP gets reputation-blocked by a site's bot protection again). Leave unset
# to fetch directly.
# PLAYWRIGHT_PROXY_SERVER=
# PLAYWRIGHT_PROXY_USERNAME=
# PLAYWRIGHT_PROXY_PASSWORD=
